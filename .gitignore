/wwebjs_sessions/
/baileys_sessions/
wa-server/.wwebjs_auth/

# Backups manuales (historial en disco, no en git)
*.bak
*.bak.*

# Logs de build y debug sueltos
build*.log
HISTORIAL_ELIMINADO.md

# Datos locales del Motor de Conocimiento (viven en el VPS, no en git)
Motor de Conocimiento/data/products/*.bak
Motor de Conocimiento/logs/

# Scratch y snapshots locales
/scratch/

